# URL del backend (sin barra final). Si se omite, la app usa localStorage.
# En Cloudflare Pages, configúrala como variable de build.
# VITE_API_URL=https://tu-api.example.com/api

# Clave de Gemini (queda en el bundle del frontend; no la uses como secreto de producción).
# En Cloudflare Pages usa VITE_GEMINI_API_KEY.
# VITE_GEMINI_API_KEY=
